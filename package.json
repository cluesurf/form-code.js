{
  "name": "@cluesurf/wash",
  "version": "0.10.8",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./lint": "./host/lint.js",
    "./flow.json": "./flow.json",
    "./load.js": "./load.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "scan": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "test": "npx ts-node-esm test.ts",
    "make": "rm -rf host && tsc && tsc-alias && cp flow.json host",
    "host": "pnpm make && npm publish --access=public"
  },
  "prettier": "./flow.json",
  "dependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "prettier": "3.8.1",
    "typescript-eslint": "8.55.0"
  },
  "bin": "./load.js",
  "devDependencies": {
    "@types/node": "25.2.3",
    "concurrently": "9.2.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "10.0.3",
      "@isaacs/brace-expansion": ">=5.0.1"
    }
  }
}
