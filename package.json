{
  "name": "@cluesurf/wash",
  "version": "0.6.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "scan": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "test": "npx ts-node-esm test.ts",
    "make": "rm -rf host && tsc && tsc-alias",
    "host": "pnpm make && npm publish --access=public"
  },
  "prettier": "./flow.json",
  "dependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.1"
  },
  "bin": "./load.js",
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/prettier": "^3.0.0",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.15",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "10.0.3"
    }
  }
}
