{
  "compilerOptions": {
    "lib": ["es2020", "dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "module": "Node16",
    "target": "ES2015",
    "moduleResolution": "node16",
    "outDir": "host",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": [
    "*.ts",
    "**/*.ts",
    "lint.ts",
    "*.json",
    "eslint.config.js",
    "love.js",
    "load.js"
  ],
  "exclude": ["node_modules", "host"]
}
