{
  "compilerOptions": {
    "lib": ["es2020", "dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "outDir": "host",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": ["*.ts", "lint.ts", "eslint.config.ts", "code/*.ts"],
  "exclude": ["node_modules", "host"]
}
